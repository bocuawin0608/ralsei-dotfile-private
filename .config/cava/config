[general]
framerate = 60
bars = 64
bar_spacing = 0
bar_width = 2
# Increase for slower, smoother fall-off
sleep_timer = 0

[input]
method = pipewire
source = auto

[output]
method = noncurses
channels = stereo
# For terminal use, switch method to 'ncurses'

[color]
gradient = 1
gradient_count = 2
# These colors are overwritten by the matugen theme engine
gradient_color_1 = '#89b4fa'
gradient_color_2 = '#cba6f7'

[smoothing]
noise_reduction = 77
