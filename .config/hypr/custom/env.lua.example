-- =============================================================================
-- custom/env.lua.example
-- Copy to custom/env.lua to add or override environment variables.
-- Loaded AFTER hyprland/env.lua so your values win.
-- Syntax mirrors hyprland/env.lua exactly.
-- =============================================================================

